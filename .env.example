# Скопируй этот файл в .env и заполни значения
# .env никогда не коммитить в git

# Приложение
APP_NAME="Site Diagnostics"
# Окружение: local | production
APP_ENV=local
APP_URL=https://service-diagnostic-site.local

# База данных (в OpenServer хост — имя модуля, например MySQL-8.2)
DB_HOST=MySQL-8.2
DB_NAME=site_diagnostic
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Логгер
APP_LOG_LEVEL=warning
# Необязательно: по умолчанию storage/logs и app.log
# LOG_DIR=
# LOG_FILE=app.log

# PHP для фонового воркера (та же версия, что у сайта в OpenServer)
PHP_CLI_PATH=C:/OSPanel/modules/PHP-8.3/PHP/php.exe

# RouterAI (OpenAI-совместимый API)
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
ROUTERAI_API_KEY=

# Google PageSpeed Insights
PAGESPEED_API_KEY=

# WPScan (необязательно, источник уязвимостей WordPress)
WPSCAN_API_KEY=
